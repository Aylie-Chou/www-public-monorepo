+import { InMemoryCache } from '@apollo/client';
+
+export function createAdminMetaCache() {
+  return new InMemoryCache({
+    typePolicies: {
+      // Overview and item queries select different parts of these same objects.
+      KeystoneMeta: { merge: true },
+      KeystoneAdminMeta: { merge: true }
+      // Do not normalize list metadata by key: itemView permissions depend on
+      // the itemId argument and must remain separate for each item query.
+    }
+  });
+}
